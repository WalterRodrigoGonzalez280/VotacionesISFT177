# =============================================================================
# PHP 8.4 + Apache — Producción
# =============================================================================
FROM php:8.4-apache

# Extensiones: pdo + pdo_pgsql
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends libpq-dev git unzip; \
    rm -rf /var/lib/apt/lists/*; \
    docker-php-ext-install -j"$(nproc)" pdo pdo_pgsql; \
    rm -rf /var/tmp/*

# OPcache
RUN set -eux; \
    ls /usr/local/lib/php/extensions/*/opcache.so; \
    docker-php-ext-enable opcache

# php.ini — producción (validate_timestamps=0)
RUN { \
      echo 'date.timezone = America/Argentina/Buenos_Aires'; \
      echo 'session.cookie_lifetime = 86400'; \
      echo 'session.gc_maxlifetime = 86400'; \
      echo ''; \
      echo '; --- OPcache ---'; \
      echo 'opcache.enable = 1'; \
      echo 'opcache.memory_consumption = 128'; \
      echo 'opcache.interned_strings_buffer = 16'; \
      echo 'opcache.max_accelerated_files = 10000'; \
      echo 'opcache.max_wasted_percentage = 10'; \
      echo 'opcache.validate_timestamps = 0'; \
      echo 'opcache.enable_cli = 0'; \
    } > /usr/local/etc/php/php.ini

# Cabeceras de caché de Apache
COPY cache.conf /etc/apache2/conf-available/isft177-cache.conf
RUN set -eux; \
    a2enmod headers; \
    a2enconf isft177-cache; \
    test -e /etc/apache2/mods-enabled/headers.load; \
    test -e /etc/apache2/conf-enabled/isft177-cache.conf; \
    apache2ctl configtest

# Composer + dependencias (antes del COPY para cache de layer)
COPY composer.json composer.lock* /var/www/
RUN set -eux; \
    php -r "copy('https://getcomposer.org/installer', 'composer-setup.php');" \
    && php composer-setup.php --install-dir=/usr/local/bin --filename=composer \
    && rm composer-setup.php \
    && composer install --no-dev --optimize-autoloader --no-interaction \
    && rm -rf /root/.composer

# Código de la aplicación (baked into image)
COPY www/ /var/www/html/
RUN chown -R www-data:www-data /var/www/html